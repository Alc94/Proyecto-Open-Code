# Contrasena de PostgreSQL local (la usa docker compose)
POSTGRES_PASSWORD=cambia_esta_contrasena

# La lee el MCP de PostgreSQL. El contenedor del MCP llega al PostgreSQL del equipo por host.docker.internal.
DATABASE_URI="postgresql://zoo:cambia_esta_contrasena@host.docker.internal:5433/zoologic"

# La lee la API de ASP.NET Core en desarrollo (se ejecuta directamente en tu equipo, por eso localhost).
ConnectionStrings__Default="Host=localhost;Port=5433;Database=zoologic;Username=zoo;Password=cambia_esta_contrasena"
